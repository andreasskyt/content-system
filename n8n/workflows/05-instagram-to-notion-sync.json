      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "[OpenAI API key (Header Auth: Authorization: Bearer <key>)]"
        },
        "notionApi": {
          "id": "REPLACE_ME",
          "name": "[Notion API (your integration)]"
        }
      },
      "notes": "Opretter ny Notion page med IG data. Default aspect ratio 9:16 (de fleste IG posts er Reels)."
    },
