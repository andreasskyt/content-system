            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"parent\": { \"database_id\": $('SET Variables').first().json.NOTION_IG_MY_CONTENT_DB }, \"cover\": { \"type\": \"external\", \"external\": { \"url\": $json.thumbnailUrl || $json.permalink } }, \"properties\": { \"Caption\": { \"title\": [{ \"text\": { \"content\": $json.title } }] }, \"Post ID\": { \"rich_text\": [{ \"text\": { \"content\": $json.igPostId } }] }, \"URL\": { \"url\": $json.permalink }, \"Thumbnail URL\": { \"url\": $json.thumbnailUrl || $json.permalink }, \"Post Date\": { \"date\": { \"start\": $json.timestamp } }, \"Views\": { \"number\": $json.views }, \"Likes\": { \"number\": $json.likes }, \"Comments\": { \"number\": $json.comments }, \"Saves\": { \"number\": $json.saves }, \"Shares\": { \"number\": $json.shares }, \"Reach\": { \"number\": $json.reach } } }) }}",
        "options": {}
      },
      "id": "96a0cb2f-9df0-4abe-ac8c-e0976bfb7fbf",
      "name": "9. Notion – Opret Ny Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
