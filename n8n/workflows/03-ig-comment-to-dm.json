    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "[NOTION_COMMENTS_CONFIG_DB_ID]",
          "mode": "id"
        },
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Get DM Config",
      "credentials": {
        "notionApi": {
          "id": "REPLACE_ME",
          "name": "[Notion API (your integration)]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const hook = $('IG Comment In').first().json;\nconst body = hook.body || hook;\nconst cd = body.customData || body.custom_data || {};\nconst ig = (((body.triggerData || {}).igCommentOnPost || {}).ig) || {};\nconst comment = String(cd.comment_text || ig.body || body.comment_text || body.comment || (body.message && body.message.body) || '').trim();\nconst contactId = body.contact_id || body.contactId || (body.contact && body.contact.id) || '';\nconst commentId = String(ig.commentId || cd.comment_id || '').trim();\nconst permalink = String(ig.permalinkUrl || cd.post_url || '').trim();\nconst postId = String(ig.postId || cd.post_id || body.post_id || '').trim();\nconst shortcode = (permalink.match(/\\/(?:p|reel)\\/([^\\/?#]+)/) || [])[1] || postId;\nconst commenter = String(body.full_name || body.first_name || '').trim();\nif (!contactId || !comment) { return []; }\n\nconst val = (x) => {\n  if (x == null) return '';\n  if (typeof x === 'string') return x;\n  if (Array.isArray(x)) return x.map(v => (v && (v.plain_text || (v.text && v.text.content))) || '').join('');\n  if (typeof x === 'object') return x.plain_text || x.content || '';\n  return String(x);\n};\nconst rows = $('Get DM Config').all().map(i => {\n  const j = i.json;\n  const p = j.properties || j;\n  return {\n    keyword: val(j.property_keyword || p.Keyword || j.name).toUpperCase().trim(),\n    dmText: val(j.property_dm_text || p['DM Text']),\n    slug: val(j.property_landing_slug || p['Landing Slug']).trim(),\n    leadMagnet: val(j.property_lead_magnet || p['Lead Magnet']),\n    replyText: val(j.property_comment_reply || p['Comment Reply']).trim(),\n    active: j.property_active === true || p.Active === true || p.Active === '__YES__'\n  };\n}).filter(r => r.active && r.keyword);\n\nconst up = comment.toUpperCase();\nconst hit = rows.find(r => new RegExp('\\\\b' + r.keyword.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\b').test(up));\nif (!hit) { return []; }\n\nconst DEFAULT_REPLY = 'sent, you got it?';\nconst link = 'https://[WEBSITE_DOMAIN]/' + hit.slug + '?magnet=' + hit.slug + '&utm_source=instagram&utm_medium=dm&utm_content=' + encodeURIComponent(shortcode || hit.slug);\nconst dm = (hit.dmText || '').replace(/\\{\\{\\s*link\\s*\\}\\}/g, link);\nreturn [{ json: {\n  contactId, commentId, comment, commenter,\n  postRef: permalink || postId, shortcode,\n  keyword: hit.keyword, tag: 'kw-' + hit.keyword.toLowerCase(),\n  dm, leadMagnet: hit.leadMagnet, slug: hit.slug, link,\n  replyText: hit.replyText || DEFAULT_REPLY,\n  contactUrl: 'https://app.gohighlevel.com/v2/location/[GHL_LOCATION_ID]/contacts/detail/' + contactId\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Match Keyword"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.contactId }}",
