    {
      "parameters": {
        "jsCode": "const c = $input.first().json.contact || {};\nconst m = $('Match Keyword').first().json;\nconst tags = (c.tags || []).map(t => String(t).toLowerCase());\nreturn [{ json: { ...m, tags, dmSent: !tags.includes('dm-ready') } }];"
