        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ customFields: [ { id: '[GHL_FIELD_DM_PAYLOAD_ID]', value: $json.dm }, { id: '[GHL_FIELD_LEAD_MAGNET_ID]', value: $json.leadMagnet }, { id: '[GHL_FIELD_SOURCE_POST_ID]', value: $json.postRef || $json.slug } ] }) }}",
        "options": {}
