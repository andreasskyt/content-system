    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const videoId = $json.videoId;\nconst pageId = $json.pageId;\nconst title = $json.title;\nconst accessToken = $('0. Get Access Token').first().json.access_token;\n\nconsole.log(`🎬 Henter transcript for: ${title} (${videoId})`);\n\ntry {\n  // List caption tracks\n  const captionList = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://www.googleapis.com/youtube/v3/captions',\n    qs: { part: 'snippet', videoId: videoId },\n    headers: { 'Authorization': `Bearer ${accessToken}` }\n  });\n\n  const tracks = captionList.items || [];\n  console.log(`📋 Caption tracks: ${tracks.length}`);\n\n  if (tracks.length === 0) {\n    return { json: { pageId, videoId, title, transcript: null, error: 'No caption tracks' } };\n  }\n\n  // Prioriter: English ASR > Danish ASR > English manual > first\n  let track = tracks.find(t => t.snippet.trackKind === 'ASR' && t.snippet.language === 'en')\n    || tracks.find(t => t.snippet.trackKind === 'ASR' && t.snippet.language === 'da')\n    || tracks.find(t => t.snippet.language === 'en')\n    || tracks.find(t => t.snippet.language === 'da')\n    || tracks[0];\n\n  console.log(`🎯 Track: ${track.snippet.language} (${track.snippet.trackKind})`);\n\n  // Download caption som SRT\n  const captionSrt = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `https://www.googleapis.com/youtube/v3/captions/${track.id}`,\n    qs: { tfmt: 'srt' },\n    headers: { 'Authorization': `Bearer ${accessToken}` }\n  });\n\n  // Parse SRT\n  const blocks = String(captionSrt).split(/\\n\\n+/);\n  let transcriptLines = [];\n  let plainTextLines = [];\n\n  for (const block of blocks) {\n    const lines = block.trim().split('\\n');\n    if (lines.length < 3) continue;\n\n    const timeMatch = lines[1].match(/(\\d{2}):(\\d{2}):(\\d{2})/);\n    if (!timeMatch) continue;\n\n    const hours = parseInt(timeMatch[1]);\n    const minutes = parseInt(timeMatch[2]) + (hours * 60);\n    const seconds = parseInt(timeMatch[3]);\n    const timestamp = `${minutes}:${seconds.toString().padStart(2, '0')}`;\n\n    const text = lines.slice(2).join(' ').trim();\n    if (!text) continue;\n\n    transcriptLines.push(`[${timestamp}] ${text}`);\n    plainTextLines.push(text);\n  }\n\n  if (transcriptLines.length === 0) {\n    return { json: { pageId, videoId, title, transcript: null, error: 'SRT parsed but empty' } };\n  }\n\n  const transcriptWithTimestamps = transcriptLines.join('\\n');\n  const transcriptPlain = plainTextLines.join(' ');\n\n  console.log(`✅ Transcript: ${transcriptLines.length} linjer, ${transcriptPlain.length} tegn`);\n\n  return {\n    json: {\n      pageId, videoId, title,\n      transcript: transcriptWithTimestamps,\n      transcriptPlain,\n      transcriptLength: transcriptPlain.length,\n      language: track.snippet.language,\n      isAutoGenerated: track.snippet.trackKind === 'ASR',\n      error: null\n    }\n  };\n\n} catch (err) {\n  console.log(`❌ Fejl: ${err.message}`);\n  return { json: { pageId, videoId, title, transcript: null, error: err.message } };\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
