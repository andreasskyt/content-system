        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"filter\": { \"property\": \"Video ID\", \"rich_text\": { \"equals\": $json.videoId } } }) }}",
        "options": {}
      },
      "id": "377733d9-3202-42c5-94d8-10336e0ef1a1",
      "name": "5. Notion – Søg på Video ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
