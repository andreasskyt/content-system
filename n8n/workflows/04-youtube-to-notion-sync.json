          "name": "[OpenAI API key (Header Auth: Authorization: Bearer <key>)]"
        },
        "notionApi": {
          "id": "REPLACE_ME",
          "name": "[Notion API (your integration)]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst allVideos = $('4. Merge Data + Analytics').all();\n\nreturn items.map((item, index) => {\n  const notionResponse = item.json;\n  const currentVideo = allVideos[index].json;\n  \n  const found = notionResponse.results && notionResponse.results.length > 0;\n  \n  // Hent eksisterende Platforms fra Notion page\n  let existingPlatforms = [];\n  if (found && notionResponse.results[0].properties?.Platforms?.multi_select) {\n    existingPlatforms = notionResponse.results[0].properties.Platforms.multi_select.map(p => p.name);\n  }\n  \n  // Tilføj YouTube hvis den ikke allerede er der\n  if (!existingPlatforms.includes('YouTube')) {\n    existingPlatforms.push('YouTube');\n  }\n  \n  return {\n    json: {\n      matchType: found ? 'videoId' : 'none',\n      notionPageId: found ? notionResponse.results[0].id : null,\n      found: found,\n      platforms: existingPlatforms,\n      videoId: currentVideo.videoId,\n      title: currentVideo.title,\n      publishedAt: currentVideo.publishedAt,\n      description: currentVideo.description,\n      thumbnailUrl: currentVideo.thumbnailUrl,\n      youtubeUrl: currentVideo.youtubeUrl,\n      views: currentVideo.views,\n      likes: currentVideo.likes,\n      comments: currentVideo.comments,\n      watchTimeHours: currentVideo.watchTimeHours,\n      subscribersGained: currentVideo.subscribersGained,\n      durationSeconds: currentVideo.durationSeconds,\n      aspectRatio: currentVideo.aspectRatio\n    }\n  };\n});"
      },
      "id": "739378a4-4555-47b2-b6f1-e3b3efa302ca",
