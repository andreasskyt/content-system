      "name": "4. Has Transcript?"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Byg Notion API body til at appende transcript som toggle block\nconst pageId = $json.pageId;\nconst transcript = $json.transcript;\nconst title = $json.title;\nconst language = $json.language;\nconst isAuto = $json.isAutoGenerated;\n\n// Split transcript i chunks af max 2000 tegn (Notion rich_text grænse per block)\nconst maxChunkSize = 1900; // Lidt under 2000 for sikkerhed\nconst lines = transcript.split('\\n');\nlet chunks = [];\nlet currentChunk = '';\n\nfor (const line of lines) {\n  if ((currentChunk + '\\n' + line).length > maxChunkSize && currentChunk) {\n    chunks.push(currentChunk.trim());\n    currentChunk = line;\n  } else {\n    currentChunk = currentChunk ? currentChunk + '\\n' + line : line;\n  }\n}\nif (currentChunk.trim()) {\n  chunks.push(currentChunk.trim());\n}\n\nconsole.log(`📝 Transcript splittet i ${chunks.length} chunks for Notion`);\n\n// Byg children blocks til toggle\n// Hvert chunk bliver et paragraph block inde i toggle\nconst children = chunks.map(chunk => ({\n  object: 'block',\n  type: 'paragraph',\n  paragraph: {\n    rich_text: [{\n      type: 'text',\n      text: { content: chunk }\n    }]\n  }\n}));\n\n// Heading text med metadata\nconst langLabel = language === 'da' ? 'Dansk' : language === 'en' ? 'English' : language;\nconst autoLabel = isAuto ? ' (auto-generated)' : '';\nconst toggleTitle = `📜 Video Transcript — ${langLabel}${autoLabel}`;\n\n// Notion append blocks body\nconst body = {\n  children: [\n    {\n      object: 'block',\n      type: 'toggle',\n      toggle: {\n        rich_text: [{\n          type: 'text',\n          text: { content: toggleTitle },\n          annotations: { bold: true }\n        }],\n        children: children\n      }\n    }\n  ]\n};\n\nreturn {\n  json: {\n    pageId,\n    title,\n    body,\n    chunkCount: chunks.length,\n    transcriptLength: transcript.length\n  }\n};"
      },
