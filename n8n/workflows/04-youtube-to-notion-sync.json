    {
      "parameters": {
        "jsCode": "const notionResponses = $input.all();\nconst videoData = $('6. Evaluer Video ID Match').all().filter(item => !item.json.found);\n\nreturn notionResponses.map((item, index) => {\n  const video = videoData[index] ? videoData[index].json : {};\n  const notionResults = item.json.results || [];\n  const found = notionResults.length > 0;\n\n  return {\n    json: {\n      matchType: found ? 'title' : 'none',\n      notionPageId: found ? notionResults[0].id : null,\n      found: found,\n      videoId: video.videoId,\n      title: video.title,\n      publishedAt: video.publishedAt,\n      description: video.description,\n      thumbnailUrl: video.thumbnailUrl,\n      youtubeUrl: video.youtubeUrl,\n      views: video.views || 0,\n      likes: video.likes || 0,\n      comments: video.comments || 0,\n      watchTimeHours: video.watchTimeHours || 0,\n      subscribersGained: video.subscribersGained || 0,\n      ctrPercent: video.ctrPercent || 0,\n      durationSeconds: video.durationSeconds || 0,\n      aspectRatio: video.aspectRatio || '16:9'\n    }\n  };\n});"
      },
