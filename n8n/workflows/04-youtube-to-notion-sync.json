            {
              "name": "Authorization",
              "value": "=Bearer {{ $('3b-auth. Hent Access Token').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "35328cd0-39d2-42fb-8dec-f819ce7e0840",
      "name": "3b. YouTube Analytics API – Watch Time, CTR, Subs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -3072,
        -592
      ],
      "notes": "Henter watch time, subscribers gained og CTR fra YouTube Analytics API. Kræver OAuth scope: yt-analytics.readonly"
    },
    {
      "parameters": {
        "jsCode": "const dataApiResponse = $('3a. YouTube Data API – Statistics').first().json;\nconst snippetData = $('2. Saml Video IDs').first().json.videos;\n\n// Parse Analytics API data\nconst analyticsMap = {};\ntry {\n  const analyticsResponse = $('3b. YouTube Analytics API – Watch Time, CTR, Subs').first().json;\n  if (analyticsResponse.rows) {\n    for (const row of analyticsResponse.rows) {\n      analyticsMap[row[0]] = {\n        watchTimeMinutes: row[1] || 0,\n        subscribersGained: row[2] || 0\n      };\n    }\n  }\n} catch (e) {\n  // Analytics API fejlede — fortsæt med 0-værdier\n}\n\n// Parse ISO 8601 duration\nfunction parseDuration(iso) {\n  if (!iso) return 0;\n  const match = iso.match(/PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/);\n  if (!match) return 0;\n  const hours = parseInt(match[1] || '0');\n  const minutes = parseInt(match[2] || '0');\n  const seconds = parseInt(match[3] || '0');\n  return hours * 3600 + minutes * 60 + seconds;\n}\n\nconst statsMap = {};\nif (dataApiResponse.items) {\n  for (const item of dataApiResponse.items) {\n    const durationSeconds = parseDuration(item.contentDetails?.duration);\n    statsMap[item.id] = {\n      viewCount: parseInt(item.statistics.viewCount || '0'),\n      likeCount: parseInt(item.statistics.likeCount || '0'),\n      commentCount: parseInt(item.statistics.commentCount || '0'),\n      durationSeconds: durationSeconds,\n      aspectRatio: durationSeconds < 120 ? '9:16' : '16:9'\n    };\n  }\n}\n\nconst mergedVideos = snippetData.map(video => {\n  const stats = statsMap[video.videoId] || { viewCount: 0, likeCount: 0, commentCount: 0, durationSeconds: 0, aspectRatio: '16:9' };\n  const analytics = analyticsMap[video.videoId] || { watchTimeMinutes: 0, subscribersGained: 0 };\n\n  return {\n    json: {\n      videoId: video.videoId,\n      title: video.title,\n      publishedAt: video.publishedAt,\n      description: video.description,\n      thumbnailUrl: video.thumbnailUrl,\n      youtubeUrl: `https://youtube.com/watch?v=${video.videoId}`,\n      views: stats.viewCount,\n      likes: stats.likeCount,\n      comments: stats.commentCount,\n      watchTimeHours: Math.round((analytics.watchTimeMinutes / 60) * 100) / 100,\n      subscribersGained: analytics.subscribersGained,\n      ctrPercent: 0,\n      durationSeconds: stats.durationSeconds,\n      aspectRatio: stats.aspectRatio\n    }\n  };\n});\n\nreturn mergedVideos;"
      },
      "id": "90d808e2-fef8-4e23-9814-b012e732e4c4",
      "name": "4. Merge Data + Analytics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2880,
        -592
      ],
      "notes": "Samler statistics fra Data API og analytics fra Analytics API til ét objekt per video. Output: array af videoer med alle 6 metrics."
