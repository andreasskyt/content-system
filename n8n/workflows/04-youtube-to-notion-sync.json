      "id": "e217186d-cafc-43cc-99c5-681456070c9d",
      "name": "1. YouTube Search – Hent videoer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -3056,
        -816
      ],
      "notes": "Henter de seneste 50 videoer fra din kanal via YouTube Data API v3. VIGTIGT: Erstat 'DIT_CHANNEL_ID_HER' med dit faktiske channel ID, eller sæt det som variabel."
    },
    {
      "parameters": {
        "jsCode": "// Saml alle video IDs fra search results\nconst items = $input.all();\nconst searchResults = items[0].json;\n\nif (!searchResults.items || searchResults.items.length === 0) {\n  return [{ json: { videoIds: '', videos: [], count: 0 } }];\n}\n\nconst videos = searchResults.items.map(item => ({\n  videoId: item.id.videoId,\n  title: item.snippet.title,\n  publishedAt: item.snippet.publishedAt,\n  description: item.snippet.description,\n  thumbnailUrl: item.snippet.thumbnails?.high?.url || item.snippet.thumbnails?.default?.url || ''\n}));\n\nconst videoIds = videos.map(v => v.videoId).join(',');\n\nreturn [{ json: { videoIds, videos, count: videos.length } }];"
      },
      "id": "c8f2a6ab-27e4-4307-a7f6-06cc332442fa",
      "name": "2. Saml Video IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2832,
        -816
      ],
      "notes": "Ekstraher alle video IDs til ét komma-separeret string + gem snippet data til senere brug."
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/videos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "statistics,snippet,contentDetails"
            },
            {
              "name": "id",
              "value": "={{ $json.videoIds }}"
            },
            {
              "name": "key",
              "value": "={{ $('SET Variables').item.json.YT_DATA_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f60267eb-96db-477f-9c5e-77c4c91b114d",
      "name": "3a. YouTube Data API – Statistics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -3488,
        -592
      ],
      "notes": "Henter views, likes, comments for alle videoer i ét batch call."
    },
    {
      "parameters": {
        "url": "https://youtubeanalytics.googleapis.com/v2/reports",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ids",
              "value": "channel==MINE"
            },
            {
              "name": "startDate",
              "value": "2020-01-01"
            },
            {
              "name": "endDate",
              "value": "={{ $now.format('yyyy-MM-dd') }}"
            },
            {
              "name": "metrics",
              "value": "estimatedMinutesWatched,subscribersGained"
            },
            {
              "name": "dimensions",
              "value": "video"
            },
            {
              "name": "filters",
              "value": "=video=={{ $('2. Saml Video IDs').item.json.videoIds.split(',').join(',') }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
