      "id": "3eb73481-4f3a-445c-9eee-a231c864f103",
      "name": "Slack Notification",
      "credentials": {
        "slackApi": {
          "id": "REPLACE_ME",
          "name": "[Slack Bot]"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6,8,10,12 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        320
      ],
      "id": "4b02b847-9bed-4595-9552-db4f419e6af2",
      "name": "Schedule (8, 10, 12, 14)"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "[NOTION_CPP_DB_ID]",
          "mode": "id"
        },
        "returnAll": true,
        "simple": false,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "key": "Status|status",
              "condition": "equals",
              "statusValue": "Ready"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        208,
        320
      ],
      "id": "f2a86def-df9d-4ec8-9d13-5b705246812f",
      "name": "Get Ready Pages",
      "credentials": {
        "notionApi": {
          "id": "REPLACE_ME",
          "name": "[Notion API (your integration)]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json.properties || {};\n  if ((p['Type']?.select?.name || '') !== 'Story') continue;\n  const due = p['Upload Date']?.date?.start;\n  if (!due) continue;\n  if (new Date(due) > now) continue;\n  out.push({ json: { pageId: item.json.id } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        320
      ],
      "id": "beac5435-3809-4ee8-99d0-dac5207fdc83",
      "name": "Filter Due Stories"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://[N8N_HOST]/webhook/story-now",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"pageId\": \"{{ $json.pageId }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        624,
        320
      ],
      "id": "96479251-a9bd-4493-8b2e-2280bdd34176",
      "name": "Trigger Story Webhook"
    }
