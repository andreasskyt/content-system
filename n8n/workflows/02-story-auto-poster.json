      "id": "2f4304af-385a-463d-997d-8699f24f792b",
      "name": "Publish Story Frame",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "[Meta Graph API — System User token (Header Auth: Authorization: Bearer <token>)]"
