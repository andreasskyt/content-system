              "name": "SLACK_CHANNEL",
              "value": "[SLACK_CHANNEL_ID]",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        208,
        0
      ],
      "id": "1c9bfed5-f4c8-4285-8247-ca3d1ec2c7fb",
      "name": "SET Variables"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "get",
        "pageId": {
          "__rl": true,
          "value": "={{ $('Webhook — Story Now').first().json.body.pageId }}",
          "mode": "id"
        },
        "simple": false
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        416,
        0
      ],
      "id": "3c2331b9-4aaf-4c60-84f1-87bed0fcfe86",
      "name": "Get Story Page",
      "credentials": {
        "notionApi": {
          "id": "REPLACE_ME",
          "name": "[Notion API (your integration)]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const notion = $input.first().json;\nconst props = notion.properties || {};\nconst type = props['Type']?.select?.name || '';\nif (type !== 'Story') throw new Error('Page Type is \"' + type + '\", expected \"Story\"');\nconst titleBlocks = props['Title']?.title || [];\nconst pageTitle = titleBlocks.map(b => b.plain_text || '').join('').trim();\nconst files = (props['Stories Media']?.files || [])\n  .map(f => ({ name: f.name || '', url: f.file?.url || f.external?.url }))\n  .filter(f => f.url);\nif (!files.length) throw new Error('No files attached in \"Stories Media\"');\nfiles.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));\nreturn [{ json: { pageId: notion.id, pageTitle, storyFiles: files.map(f => f.url), frameCount: files.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "6fce4ce6-4028-4f65-bfb3-0e804c67b609",
      "name": "Extract Story Data"
    },
    {
      "parameters": {
        "fieldToSplitOut": "storyFiles",
        "include": "allOtherFields",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        832,
        0
      ],
      "id": "76d1d336-1163-4564-b9b7-c74c5562a77b",
      "name": "Split Out Frames"
    },
    {
      "parameters": {
        "url": "={{ $json.storyFiles }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ],
      "id": "fa77015b-b5bd-40fd-a081-e01e4e9a0846",
      "name": "Download Frame"
    },
    {
      "parameters": {
        "operation": "upload",
        "bucketName": "={{ $('SET Variables').first().json.S3_BUCKET }}",
        "fileName": "=stories/{{ $('Extract Story Data').first().json.pageId }}/frame_{{ String($itemIndex + 1).padStart(2, '0') }}.png",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        1248,
        0
      ],
      "id": "57e19d8a-4ade-4c6d-920b-04ae0ca61450",
      "name": "Upload Frame to S3",
      "credentials": {
        "s3": {
          "id": "REPLACE_ME",
          "name": "[S3 / Cloudflare R2]"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const idx = $itemIndex;\nconst ed = $('Extract Story Data').first().json;\nconst vars = $('SET Variables').first().json;\nconst fileName = `stories/${ed.pageId}/frame_${String(idx + 1).padStart(2, '0')}.png`;\nreturn { json: { pageId: ed.pageId, pageTitle: ed.pageTitle, index: idx, frameCount: ed.frameCount, publicImageUrl: `${vars.S3_PUBLIC_URL}/${fileName}` } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        0
      ],
      "id": "d4684915-e8db-49a6-a6d1-5bb80b6fcc4e",
      "name": "Build Frame URL"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1664,
        0
      ],
      "id": "c9b4c28e-eca2-41dd-aac8-8af677714193",
      "name": "Loop Frames"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v24.0/{{ $('SET Variables').first().json.IG_ACCOUNT_ID }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"media_type\": \"STORIES\",\n  \"image_url\": \"{{ $json.publicImageUrl }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1872,
        160
      ],
      "id": "5104fa83-708e-48a8-9200-eac3cdc49b3e",
      "name": "Create Story Container",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "[Meta Graph API — System User token (Header Auth: Authorization: Bearer <token>)]"
        }
      }
    },
    {
      "parameters": {
        "amount": 10
      },
      "type": "n8n-nodes-base.wait",
